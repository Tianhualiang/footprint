datasource db {
  provider = "postgresql"
}
 
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}
 
model User {
  id            String          @id @default(cuid())
  name          String?
  username      String         @unique
  email         String?
  password      String
  role          String          @default("user")
  image         String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}